[
    {config, [
        #{ files => ["src/**/*.erl"],
           ruleset => erl_files },
        #{ files => ["test/**/*.erl"],
           ruleset => erl_files_test,
           rules => [{elvis_style, no_receive_without_timeout, disable},
                     {elvis_text_style, max_line_length},
                     {elvis_text_style, no_tabs},
                     {elvis_text_style, no_trailing_whitespace}] },
        #{ files => ["rebar.config"],
           ruleset => rebar_config }
    ]},
    {verbose, true}
].
